datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DEVELOPER
  ADMIN
  MANAGER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum MovementReason {
  ORDER_RESERVATION
  ORDER_FULFILLMENT
  ORDER_CANCELLATION
  MANUAL_ADJUSTMENT
  RESTOCK
  RETURN_RESTOCK
  DAMAGE_WRITE_OFF
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum InvitationStatus {
  PENDING
  SENT
  COMPLETED
  EXPIRED
  FAILED
}

enum RewardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  REVOKED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String?
  googleId        String?          @unique
  avatarUrl       String?
  name            String
  role            Role             @default(CUSTOMER)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  customerProfile CustomerProfile?
  managerProfile  ManagerProfile?
  sessions        Session[]
  addresses       Address[]
  orders          Order[]
  reviews         ProductReview[]
  auditLogs       AuditLog[]       @relation("ActorAuditLogs")

  @@index([email])
  @@index([role])
  @@index([googleId])
}

model ManagerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] // Stored as granular permission keys
  department  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  imageUrl    String?
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  sku                String              @unique
  name               String
  description        String
  price              Int                 // Stored in minor units (e.g. Paise for INR, 100 paise = 1 INR)
  compareAtPrice     Int?
  costPrice          Int?
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  stockQuantity      Int                 @default(0)
  reservedQuantity   Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  weightGrams        Int?                @default(500)
  weight             String?             @default("500g")
  isPublished        Boolean             @default(true)
  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  reviews            ProductReview[]
  averageRating      Float               @default(5.0)
  reviewCount        Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model InventoryMovement {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta         Int            // Positive for stock in, negative for stock out
  quantityAfter Int
  reason        MovementReason
  referenceId   String?        // OrderId, adjustment ticket, etc.
  actorId       String?        // Admin or Manager userId
  notes         String?
  createdAt     DateTime       @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@index([userId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?       @relation(fields: [addressId], references: [id])
  
  // Historical snapshots
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress Json           // Full address snapshot at purchase time

  subtotal        Int            // Minor units
  shippingCost    Int            @default(0)
  taxAmount       Int            @default(0)
  discountAmount  Int            @default(0)
  totalAmount     Int            // Minor units

  orderStatus     OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(CREATED)
  
  trackingNumber      String?
  carrier             String?
  assignedManagerId   String?
  assignedManagerName String?
  couponCode          String?
  financialSnapshot   Json?
  notes               String?

  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  shipments           Shipment[]
  reviews             ProductReview[]
  reviewInvitations   ReviewInvitation[]
  platformTransaction PlatformTransaction?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  productName String         // Snapshot
  sku         String         // Snapshot
  weight      String?        // Snapshot e.g. "250g", "500g", "1kg"
  weightGrams Int?           // Snapshot e.g. 250, 500, 1000
  price       Int            // Snapshot in minor units
  quantity    Int
  total       Int            // price * quantity
  review      ProductReview?
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String         @default("RAZORPAY")
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  amount            Int            // Minor units
  currency          String         @default("INR")
  status            PaymentStatus  @default(PENDING)
  errorDescription  String?
  rawResponse       Json?
  attempts          PaymentAttempt[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model PaymentAttempt {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status     String
  attemptRef String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  razorpayRefundId String?  @unique
  amount           Int      // Minor units
  reason           String
  status           String   @default("COMPLETED")
  actorId          String?  // Admin or Manager userId
  createdAt        DateTime @default(now())

  @@index([orderId])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  provider  String   @default("RAZORPAY")
  eventType String
  payload   Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([processed])
}

model Shipment {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber String
  carrier        String
  shippedAt      DateTime    @default(now())
  deliveredAt    DateTime?
  status         OrderStatus @default(SHIPPED)

  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "MANAGER_CREATE", "PRICE_UPDATE", "STOCK_ADJUST"
  entityType String   // e.g. "Product", "User", "Order"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model StoreSettings {
  id                String   @id @default("singleton")
  storeName         String   @default("Solid Glass Commerce")
  currency          String   @default("INR")
  currencySymbol    String   @default("₹")
  supportEmail      String   @default("support@solidglassecommerce.com")
  taxRatePercent    Float    @default(18.0)
  shippingFlatRate  Int      @default(5000) // 50.00 INR
  freeShippingAbove Int      @default(99900) // 999.00 INR
  chatwootEnabled   Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model DiscountCoupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  description        String
  discountType       String        @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT
  value              Int           // e.g. 15 for 15% or 10000 for ₹100
  minOrderAmount     Int           @default(0) // in minor units (paise)
  maxDiscountAmount  Int?          // in minor units (paise)
  expiresAt          DateTime?
  usageLimit         Int?
  usedCount          Int           @default(0)
  isPublic           Boolean       @default(false)
  isActive           Boolean       @default(true)
  customerEmail      String?       // Customer-specific restriction for review rewards
  customerId         String?       // Customer-specific user ID restriction
  isReviewReward     Boolean       @default(false)
  reviewReward       ReviewReward?
  assignedManagerIds String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([customerEmail])
}

// ==========================================
// DEVELOPER FINANCE & CONTROL CENTRE MODELS
// ==========================================

model PlatformFinanceSettings {
  id                        String   @id @default("singleton")
  version                   Int      @default(1)
  platformFeeEnabled        Boolean  @default(true)
  feeType                   String   @default("FIXED") // FIXED | PERCENTAGE
  fixedFeePaise             Int      @default(3000) // ₹30.00
  feePercent                Float    @default(2.5) // e.g. 2.5%
  minFeePaise               Int      @default(1000) // ₹10.00 minimum for % mode
  maxFeePaise               Int      @default(10000) // ₹100.00 maximum for % mode
  platformGstEnabled        Boolean  @default(true)
  platformGstRate           Float    @default(18.0) // 18% GST
  platformGstInclusive      Boolean  @default(false)
  customerDisclosed         Boolean  @default(true)
  clientVisible             Boolean  @default(false)

  // Delivery Charge Configuration
  deliveryEnabled           Boolean  @default(true)
  deliveryFeePaise          Int      @default(7000) // ₹70.00 base courier
  deliveryGstRate           Float    @default(18.0)
  deliveryGstEnabled        Boolean  @default(true)
  deliveryGstInclusive      Boolean  @default(false)
  deliveryClientVisible     Boolean  @default(true)
  deliveryCustomerDisclosed Boolean  @default(true)

  // Product GST Configuration
  productGstEnabled         Boolean  @default(true) // Master switch: enable or disable product GST (0%)
  defaultProductGstRate     Float    @default(5.0) // 5% on raw honey HSN 0409
  productPricesGstInclusive Boolean  @default(true)
  customerGstBreakdownVisible Boolean @default(true) // Show/hide statutory tax breakdown on customer checkout

  // Client Admin Dashboard Visibility Isolation (Controls what client sees)
  showPlatformFeeToClient      Boolean  @default(false)
  showPlatformGstToClient      Boolean  @default(false)
  showDeliveryToClient         Boolean  @default(true)
  showDeliveryGstToClient      Boolean  @default(true)
  showProductGstBreakdown      Boolean  @default(true)
  showPlatformRevenueAnalytics Boolean  @default(false)
  showPlatformTransactions     Boolean  @default(false)

  effectiveFrom             DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  updatedBy                 String   @default("System Initializer")
}

model PlatformFinanceSettingsHistory {
  id            String   @id @default(cuid())
  version       Int
  snapshot      Json
  effectiveFrom DateTime @default(now())
  reason        String?
  updatedBy     String
  createdAt     DateTime @default(now())

  @@index([version])
  @@index([createdAt])
}

model PlatformBusinessProfile {
  id             String   @id @default("singleton")
  legalName      String   @default("DevTushar Software & Platform Technologies")
  tradeName      String?  @default("Ganesh Mule Tech Platform")
  gstin          String?
  pan            String?
  address        String   @default("Tech Park Hub, Maharashtra")
  city           String   @default("Pandharpur")
  state          String   @default("Maharashtra")
  stateCode      String   @default("27")
  pincode        String   @default("413304")
  email          String   @default("auth@devtushar.uk")
  phone          String   @default("+91 98765 43210")
  invoicePrefix  String   @default("PINV")
  nextInvoiceSeq Int      @default(1001)
  updatedAt      DateTime @updatedAt
}

model PlatformTransaction {
  id                        String         @id @default(cuid())
  orderId                   String         @unique
  order                     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber               String
  customerRef               String         // Anonymized/masked for privacy
  paymentRef                String?        // Razorpay payment ID
  grossOrderAmountPaise     Int            // Gross order amount in paise
  platformFeePaise          Int            // Platform fee in paise (e.g. 3000)
  platformGstRate           Float          @default(18.0)
  platformGstPaise          Int            // Applicable GST in paise (e.g. 540)
  totalPlatformServicePaise Int            // Total platform service amount in paise (e.g. 3540)
  currency                  String         @default("INR")
  paymentStatus             PaymentStatus  @default(CREATED)
  settlementStatus          String         @default("PENDING") // PENDING | SETTLED | REFUNDED
  invoiceId                 String?
  invoice                   PlatformInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([settlementStatus])
  @@index([createdAt])
}

model PlatformInvoice {
  id                  String                @id @default(cuid())
  invoiceNumber       String                @unique // e.g. PINV-2026-0001
  invoiceDate         DateTime              @default(now())
  orderId             String?
  orderNumber         String?
  clientBusinessName  String                @default("Ganesh Mule Pure Honey")
  clientGstin         String?
  clientAddress       Json?
  serviceDescription  String                @default("E-Commerce Platform Infrastructure, Payment Gateway Orchestration & Order Processing Services")
  taxableAmountPaise  Int
  gstRate             Float                 @default(18.0)
  cgstPaise           Int                   @default(0)
  sgstPaise           Int                   @default(0)
  igstPaise           Int                   @default(0)
  totalAmountPaise    Int
  status              String                @default("ISSUED") // ISSUED | PAID | CANCELLED | CREDITED
  placeOfSupply       String?               @default("Maharashtra (27)")
  notes               String?
  pdfUrl              String?
  transactions        PlatformTransaction[]
  createdAt           DateTime              @default(now())

  @@index([invoiceNumber])
  @@index([status])
  @@index([createdAt])
}

model PlatformRefundRecord {
  id                    String   @id @default(cuid())
  orderId               String
  platformTransactionId String?
  refundType            String   @default("FULL") // FULL | PARTIAL | PLATFORM_FEE_ONLY
  grossRefundPaise      Int
  platformFeeRefundPaise Int
  gstAdjustmentPaise    Int
  creditNoteNumber      String?
  reason                String
  status                String   @default("COMPLETED")
  actorId               String?
  actorEmail            String?
  createdAt             DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model PlatformFinancialAuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorEmail    String
  actorRole     String
  category      String   // PLATFORM_FEE | GST_CONFIG | DELIVERY | VISIBILITY | INVOICE | REFUND
  action        String
  previousState Json?
  newState      Json?
  reason        String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([actorEmail])
  @@index([createdAt])
}

// ==========================================
// PRODUCT RATING, REVIEW & REWARDS MODELS
// ==========================================

model ProductReview {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId        String        @unique // Strict: One review per purchased item!
  orderItem          OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  rating             Int           // 1 to 5 stars
  title              String?
  comment            String
  customerName       String
  customerEmail      String
  isVerifiedPurchase Boolean       @default(true)
  status             ReviewStatus  @default(APPROVED)
  
  reward             ReviewReward?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([customerEmail])
  @@index([status])
  @@index([orderId])
  @@index([rating])
}

model ReviewInvitation {
  id            String           @id @default(cuid())
  orderId       String
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerEmail String
  customerName  String
  token         String           @unique // Cryptographic URL-safe token for 1-click review link
  status        InvitationStatus @default(PENDING)
  scheduledFor  DateTime
  sentAt        DateTime?
  completedAt   DateTime?
  retryCount    Int              @default(0)
  errorReason   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orderId])
  @@index([customerEmail])
  @@index([token])
  @@index([status])
  @@index([scheduledFor])
}

model ReviewReward {
  id              String         @id @default(cuid())
  reviewId        String         @unique
  review          ProductReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  couponId        String         @unique
  coupon          DiscountCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId      String?
  customerEmail   String
  discountPercent Int
  status          RewardStatus   @default(ACTIVE)
  revokedReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([customerEmail])
  @@index([customerId])
  @@index([status])
}

model ReviewRewardSettings {
  id                       String   @id @default("singleton")
  isEnabled                Boolean  @default(true)
  defaultDiscountPercent   Int      @default(5)
  availablePercentages     Int[]    @default([3, 5, 7, 10])
  maxDiscountPercent       Int      @default(15)
  requireAdminApproval     Boolean  @default(false)
  autoGenerateCoupon       Boolean  @default(true)
  expiryDays               Int      @default(30)
  minOrderValuePaise       Int      @default(0)
  maxDiscountPaise         Int?
  delayDaysAfterDelivery   Int      @default(2)
  sendInvitationEmails     Boolean  @default(true)
  sendRewardEmails         Boolean  @default(true)
  allowMultipleRedemptions Boolean  @default(false)
  applicableCategoryIds    String[] @default([])
  updatedAt                DateTime @updatedAt
  updatedBy                String?
}
