# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR SOLID GLASS E-COMMERCE PLATFORM
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME (Required)
# ------------------------------------------------------------------------------
# APP_URL: Public domain URL of the application. Required for redirects and webhooks.
# SERVER-ONLY / BROWSER-SAFE: Server-side URL resolution and CORS.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL with username, password, host, port, and database name.
# SERVER-ONLY. NEVER EXPOSE TO CLIENT.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solid_glass_ecommerce?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION MANAGEMENT (Required)
# ------------------------------------------------------------------------------
# Cryptographically secure random 32+ byte string used to sign session cookies.
# Generate with: openssl rand -base64 32
# SERVER-ONLY.
SESSION_SECRET="replace-with-a-cryptographically-secure-random-string-min-32-chars"

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT INTEGRATION (Required for Checkout)
# ------------------------------------------------------------------------------
# Test mode keys obtainable from https://dashboard.razorpay.com/#/app/keys
# NEXT_PUBLIC_RAZORPAY_KEY_ID: Public client identifier used to mount Razorpay Checkout.
# BROWSER-SAFE.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"

# RAZORPAY_KEY_SECRET: Secret key used on the server to create orders and verify payment signatures.
# SERVER-ONLY. NEVER EXPOSE TO CLIENT.
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# RAZORPAY_WEBHOOK_SECRET: Secret key used to verify raw HMAC SHA256 webhook signatures.
# SERVER-ONLY. NEVER EXPOSE TO CLIENT.
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# ------------------------------------------------------------------------------
# 5. CHATWOOT LIVE CUSTOMER SUPPORT (Optional / Configurable)
# ------------------------------------------------------------------------------
# Base URL of hosted Chatwoot (e.g., https://app.chatwoot.com) or self-hosted instance.
NEXT_PUBLIC_CHATWOOT_BASE_URL="https://app.chatwoot.com"

# Website inbox token configured under Chatwoot Settings -> Inboxes -> Website.
# BROWSER-SAFE: Used by storefront widget to mount the chat bubble.
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN="YourChatwootWebsiteToken"

# CHATWOOT_API_TOKEN: User/Agent or Platform API token for server-side conversation queries.
# SERVER-ONLY. Optional for extended server-side sync.
CHATWOOT_API_TOKEN=""

# ------------------------------------------------------------------------------
# 6. S3-COMPATIBLE OBJECT STORAGE (Optional for Product Images)
# ------------------------------------------------------------------------------
# Defaults to local filesystem storage (/public/uploads) when empty.
# SERVER-ONLY.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (Optional for Order Confirmations & Password Reset)
# ------------------------------------------------------------------------------
# Defaults to development console logger when empty.
# SERVER-ONLY.
EMAIL_FROM="orders@solidglassecommerce.com"
EMAIL_PROVIDER_API_KEY=""
